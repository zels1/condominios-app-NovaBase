# Ligação à base de dados PostgreSQL (Supabase).
# No Supabase: Project Settings -> Database -> Connection string -> URI
# (usa a "Connection pooling" string em produção, porta 6543)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Segredo JWT do Supabase, para validar os tokens de login.
# No Supabase: Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# URL do frontend em produção, para configurar CORS corretamente.
FRONTEND_URL=https://o-teu-site.vercel.app

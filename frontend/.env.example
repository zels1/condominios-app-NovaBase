# URL do teu projeto Supabase (Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Chave pública "anon" do Supabase (Project Settings -> API -> Project API keys -> anon public)
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL do backend (FastAPI no Render). Em desenvolvimento local: http://localhost:8000
VITE_API_URL=https://o-teu-backend.onrender.com
